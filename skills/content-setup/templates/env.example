# Content skills: API keys and settings.
# Lives at ~/.content-skills/.env (chmod 600). Every script in these skills loads it.
# Leave a line empty if you don't use that service; doctor.sh tells you what each skill needs.

# --- Postiz (scheduling + public file hosting for Seedance) -------------------
# Settings > Public API in Postiz, or run `postiz auth:login` instead of a key.
POSTIZ_API_KEY=
# Only for self-hosted Postiz. Leave empty for postiz.com.
POSTIZ_API_URL=

# --- OpenAI (cover images, b-roll stills) --------------------------------------
OPENAI_API_KEY=
# Optional override. Default: gpt-image-2.6-sunburst
OPENAI_IMAGE_MODEL=

# --- EvoLink (Seedance 2.0 video) ---------------------------------------------
# https://evolink.ai > Dashboard > API Key Management
EVOLINK_API_KEY=

# --- HeyGen (talking-head presenter for video-shorts) -------------------------
# https://app.heygen.com > Settings > API
HEYGEN_API_KEY=
# Your avatar look and voice. Find them with:
#   node ~/.claude/skills/heygen-avatar-video/generate-video.js --list-looks
#   node ~/.claude/skills/heygen-avatar-video/generate-video.js --list-voices
# HEYGEN_VOICE_ID can stay empty: the look's own default voice is used.
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# --- ElevenLabs (background music) --------------------------------------------
ELEVENLABS_API_KEY=

# --- WordPress (where seo-builder publishes) ----------------------------------
# Full REST base, e.g. https://blog.example.com/wp-json/wp/v2
WORDPRESS_API_URL=
# The full Authorization header value. For an Application Password
# (Users > Profile > Application Passwords) it is:
#   Basic <base64 of "username:application password">
# The content-setup skill can build this for you.
WORDPRESS_API_KEY=

# --- Google Search Console (optional, real query data for SEO) ----------------
# Google Cloud project used as the quota project for Search Console API calls.
GSC_QUOTA_PROJECT=
# Search Console property, e.g. sc-domain:example.com or https://www.example.com/
GSC_PROPERTY=

# DataForSEO keeps its own login: run `dataforseo-cli --set-credentials login=... password=...`
